# .env.example -- copy to .env.local and fill in real values

# --- required ----------------------------------------------------------
DATABASE_URL=postgres://user:pass@host:5432/db
JWT_CLAIM_SECRET=replace_with_32_plus_chars__________________________
JWT_SESSION_SECRET=replace_with_32_plus_chars__________________________
APP_BASE_URL=http://localhost:3000

# Admin / lawyer ops console (min 16 chars each, distinct values)
OPS_PASSWORD=replace_with_16_plus_chars_secret_______
OPS_COOKIE=replace_with_16_plus_chars_secret_________

# --- optional (system runs in stub mode without these) -----------------

# Vercel AI Gateway (Anthropic Haiku for OCR + classification, Sonnet for letters)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Resend (transactional email + inbound mailbox webhook)
RESEND_API_KEY=re_xxx
RESEND_FROM=no-reply@tashlemli.co.il

# Vercel Blob (private file storage for boarding passes + demand letters)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# AviationStack (flight status lookup -- stub fallback if absent)
AVIATIONSTACK_KEY=

# Upstash Redis (rate limiting -- disabled if absent)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Documenso Cloud (eSign for Powers of Attorney)
DOCUMENSO_API_KEY=
DOCUMENSO_BASE_URL=https://app.documenso.com/api/v1

# Cloudflare Turnstile (anti-bot on /check -- bypassed if absent)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NODE_ENV=development
